{
  "name": "hashface",
  "version": "0.1.0",
  "description": "Deterministic, dependency-free SVG avatars in a bold-blocks style. Same string in, same face out.",
  "keywords": [
    "avatar",
    "identicon",
    "svg",
    "deterministic",
    "generator"
  ],
  "homepage": "https://github.com/Waiivyy/hashface#readme",
  "bugs": {
    "url": "https://github.com/Waiivyy/hashface/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Waiivyy/hashface.git"
  },
  "license": "MIT",
  "author": "Waiivyy",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./costumes": {
      "types": "./dist/costumes/index.d.ts",
      "default": "./dist/costumes/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json --removeComments --declaration false && tsc -p tsconfig.build.json --emitDeclarationOnly && node scripts/fix-declarations.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.build.json --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "pack:check": "node scripts/pack-check.ts",
    "demo": "npm run build && node scripts/serve.ts",
    "site": "npm run build && node scripts/site.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
